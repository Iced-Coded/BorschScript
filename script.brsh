<змінна назва="лічильник">1</змінна>

<поки умова="лічильник <= 3">
    <друк>f"Варимо порцію борщу №{лічильник}"</друк>
    <змінна назва="лічильник">лічильник + 1</змінна>
</поки>

<якщо умова="лічильник > 3">
    <друк>"Борщ готовий!"</друк>
</якщо>
<інакше>
    <друк>"Замало інгредієнтів..."</друк>
</інакше>